{
  "name": "agent-canvas-visualizer",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:web",
    "dev:server": "npm run dev -w @acv/server",
    "dev:web": "npm run dev -w @acv/web",
    "build": "npm run build -w @acv/shared && npm run build -w @acv/server && npm run build -w @acv/web",
    "test": "npm run test -w @acv/shared && npm run test -w @acv/server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^9.4.3"
  }
}
