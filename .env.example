# Provider switch: api | claude
AGENT_PROVIDER=claude

# For claude provider — uses Claude Code CLI
AGENT_COMMAND=claude

# For api provider (OpenAI-compatible API with tool calling)
AGENT_API_KEY=
AGENT_MODEL=deepseek-chat
AGENT_BASE_URL=https://api.deepseek.com

# Sandbox root for tool file operations in api mode (defaults to cwd)
SANDBOX_ROOT=

PORT=8787

# Backward compatibility (optional):
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=
